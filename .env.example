# AXON Official Website Environment Configuration
# Copy to .env.local for production/cloud integrations

# Session Signing Secret (generate a strong 32+ char secret in production)
AXON_SESSION_SECRET=axon-imac-uet-lahore-dev-secret-change-in-production

# Optional: GitHub Personal Access Token (increases GitHub API rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Optional: Supabase Production Backend (when upgrading from local JSON persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site Canonical Base URL
NEXT_PUBLIC_SITE_URL=https://axon.org.pk
